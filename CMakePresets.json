{
  "version": 3,
  "configurePresets": [
    {
      "name": "desktop-macos",
      "displayName": "macOS Desktop (No VR)",
      "description": "Builds for macOS in 2D windowed mode without OpenXR dependencies.",
      "binaryDir": "${sourceDir}/build/desktop-macos",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "BUILD_NATIVE_DRM": "OFF",
        "ENABLE_OPENXR": "OFF",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "desktop-linux-vr",
      "displayName": "Linux Desktop VR (WiVRn / Monado)",
      "description": "Builds for Linux desktop with OpenXR and X11/Wayland windowing.",
      "binaryDir": "${sourceDir}/build/desktop-linux-vr",
      "cacheVariables": {
        "CMAKE_C_COMPILER":"/usr/bin/clang",
        "CMAKE_CXX_COMPILER":"/usr/bin/clang++",
        "BUILD_NATIVE_DRM": "OFF",
        "ENABLE_OPENXR": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "arm-native-drm",
      "displayName": "Native Mode ARM (Bare-Metal DRM/KMS + VR)",
      "description": "Builds for raw TTY execution targeting Raspberry Pi / Radxa with OpenXR.",
      "binaryDir": "${sourceDir}/build/arm-native",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/aarch64-linux-gnu-gcc",
        "CMAKE_CXX_COMPILER": "/usr/bin/aarch64-linux-gnu-g++",
        "BUILD_NATIVE_DRM": "ON",
        "ENABLE_OPENXR": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ]
}