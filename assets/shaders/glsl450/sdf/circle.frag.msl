#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct FragmentUniforms
{
    float4x4 u_view_projection;
    float2 u_center;
    float2 u_padding1;
    float4 u_color;
    float u_radius;
    float u_feather;
    float2 u_padding2;
};

struct main0_out
{
    float4 frag_color [[color(0)]];
};

struct main0_in
{
    float2 v_local_pos [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant FragmentUniforms& _18 [[buffer(0)]])
{
    main0_out out = {};
    float dist = length(in.v_local_pos) * (_18.u_radius + _18.u_feather);
    float sdf = dist - _18.u_radius;
    float alpha = 1.0 - smoothstep(-_18.u_feather, _18.u_feather, sdf);
    if (alpha <= 0.0)
    {
        discard_fragment();
    }
    out.frag_color = float4(_18.u_color.xyz, _18.u_color.w * alpha);
    return out;
}

